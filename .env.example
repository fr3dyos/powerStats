# ---------------------------------------------------------------------------
# PowerStats environment variables
# Copy this file to `.env` and fill in the real values before running the app.
# Never commit the real `.env` file (it is in .gitignore).
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijkl.supabase.co
SUPABASE_URL=

# Supabase anon (public) key — safe to use browser-side.
SUPABASE_ANON_KEY=

# Supabase service role key — SERVER-SIDE ONLY. Never expose in the browser.
# Grants the backend a client that bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=

# SQLAlchemy / Postgres connection string for the backend.
# Use the Supabase "Session pooler" string for server connections.
# Format:
#   postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
DATABASE_URL=

# Backward-compatible alias (optional, only needed if you used SUPABASE_DB_URL).
# SUPABASE_DB_URL=

# Default storage bucket used for logo/photo uploads (optional).
# SUPABASE_STORAGE_BUCKET=

# Comma-separated list of allowed CORS origins for the FastAPI app.
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000

