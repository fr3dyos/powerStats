# PowerStats environment template
# Copy to .env and fill in real values. Never commit .env.

# Supabase project URL (from Project Settings > API)
SUPABASE_URL=https://your-project.supabase.co

# Supabase public anon key (safe for browser / frontend)
SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key (server-only, bypasses RLS — keep secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Postgres connection string for SQLAlchemy (from Project Settings > Database)
# Example: postgresql://postgres:[password]@db.your-project.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Fallback name used by some generated code (same value as DATABASE_URL)
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Next.js public variables (same as SUPABASE_URL / SUPABASE_ANON_KEY)
# Note: the Next.js app reads NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Supabase Storage bucket for team logos / player photos
SUPABASE_STORAGE_BUCKET=team-logos
